# MoveABox GBP Agent — Git Ignore

# Environment and secrets
config/.env
config/token.json
config/credentials.json
config/gsc-service-account.json
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
*.egg-info/
dist/
build/

# Logs
logs/*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Generated output (large files)
output/images/*.png
output/images/*.jpg

# Temporary files
*.tmp
*.bak
