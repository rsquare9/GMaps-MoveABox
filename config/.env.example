# MoveABox GBP Agent — Environment Configuration
# Copy this file to config/.env and fill in your actual values
# NEVER commit config/.env to version control

# =============================================================================
# Google Business Profile API
# =============================================================================
# OAuth2 credentials (download from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GBP Account IDs for each location (from GBP API account listing)
GBP_ACCOUNT_BANNERGHATTA=accounts/XXXXXXXXXXXXXXXX/locations/XXXXXXXXXXXXXXXXX
GBP_ACCOUNT_BANASHANKARI=accounts/XXXXXXXXXXXXXXXX/locations/XXXXXXXXXXXXXXXXX
GBP_ACCOUNT_KORAMANGALA=accounts/XXXXXXXXXXXXXXXX/locations/XXXXXXXXXXXXXXXXX

# =============================================================================
# Google Search Console API
# =============================================================================
GSC_SITE_URL=https://moveabox.in/
GSC_SERVICE_ACCOUNT_JSON=config/gsc-service-account.json

# =============================================================================
# Competitor Data APIs
# =============================================================================
# Outscraper — GBP scraping
OUTSCRAPER_API_KEY=your_outscraper_api_key

# SerpAPI — Google Maps search results
SERPAPI_KEY=your_serpapi_key

# =============================================================================
# Notifications
# =============================================================================
# Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Slack Channel Names (override defaults)
SLACK_CHANNEL_DAILY=#gbp-daily
SLACK_CHANNEL_WEEKLY=#gbp-weekly
SLACK_CHANNEL_ALERTS=#gbp-alerts
SLACK_CHANNEL_ESCALATIONS=#escalations
SLACK_CHANNEL_COMPETITOR=#competitor-intel

# WhatsApp API (WATI / Twilio)
WHATSAPP_API_URL=https://live-mt-server.wati.io/YOUR_ACCOUNT/api/v1/sendSessionMessage
WHATSAPP_API_TOKEN=your_whatsapp_api_token
WHATSAPP_GROUP_ID=your_group_id

# =============================================================================
# Location Contact Details
# =============================================================================
# Bannerghatta Road
PHONE_BANNERGHATTA=+91-XXXXXXXXXX
ADDRESS_BANNERGHATTA=JP Nagar 5th Phase, Bannerghatta Road, Bangalore - 560076
STREET_BANNERGHATTA=JP Nagar 5th Phase
POSTAL_BANNERGHATTA=560076
MANAGER_BANNERGHATTA=Manager Name

# Banashankari
PHONE_BANASHANKARI=+91-XXXXXXXXXX
ADDRESS_BANASHANKARI=Banashankari Stage 2, Bangalore - 560070
STREET_BANASHANKARI=Banashankari Stage 2
POSTAL_BANASHANKARI=560070
MANAGER_BANASHANKARI=Manager Name

# Koramangala
PHONE_KORAMANGALA=+91-XXXXXXXXXX
ADDRESS_KORAMANGALA=Koramangala 4th Block, Bangalore - 560034
STREET_KORAMANGALA=Koramangala 4th Block
POSTAL_KORAMANGALA=560034
MANAGER_KORAMANGALA=Manager Name

# =============================================================================
# Database (Optional — Supabase / PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql://user:password@host:5432/moveabox_gbp
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# =============================================================================
# Image Generation (Optional)
# =============================================================================
CANVA_API_KEY=your_canva_api_key
OPENAI_API_KEY=your_openai_api_key_for_dalle

# =============================================================================
# Claude API (if running agents programmatically)
# =============================================================================
ANTHROPIC_API_KEY=your_anthropic_api_key
